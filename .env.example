# Secrets only (ADR-012: customer settings live in the DB, not in env).
POSTGRES_PASSWORD=change-me
EVE_OWNER_PASSWORD=change-me
EVE_APP_PASSWORD=change-me

# Runtime connection (least-privilege app role).
DATABASE_URL=postgresql://eve_app:change-me@localhost:5432/eve
# Migration connection (owner role).
MIGRATION_DATABASE_URL=postgresql://eve_owner:change-me@localhost:5432/eve

# Empty = Docker Hub. Set to e.g. "harbor.internal/proxy/" for the internal mirror.
IMAGE_REGISTRY=
LOG_LEVEL=info
