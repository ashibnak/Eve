  knownAt    DateTime   @map("known_at") @db.Timestamptz(6)
  trigger    String
  rules      Json
  opened     Int
  resolved   Int
  stillOpen  Int        @map("still_open")
  accepted   Int
  startedAt  DateTime   @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime   @map("finished_at") @db.Timestamptz(6)

  firstFindings OrgFinding[] @relation("FindingFirstRun")
  lastFindings  OrgFinding[] @relation("FindingLastRun")

  @@index([companyId, finishedAt(sort: Desc)], map: "org_rule_run_company_idx")
