// Eve schema. Models arrive with their slices; tables are prefixed by module slug (ADR-002).
// Constraints Prisma cannot express (exclusion constraints, grants) live in hand-written
// SQL migrations under prisma/migrations/NNNN_<name>/ — forward-only.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── platform/company ────────────────────────────────────────────────────────

model CoreCompany {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique
  jurisdictionCode String   @map("jurisdiction_code")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  auditEntries AuditLog[]
  outboxEvents EventsOutbox[]
  settings     ConfigSetting[]

  @@map("core_company")
}

// ── platform/audit (append-only; see migration 0003) ────────────────────────

model AuditLog {
  seq           BigInt       @id @default(autoincrement())
  id            String       @unique @db.Uuid
  recordedAt    DateTime     @map("recorded_at") @db.Timestamptz(6)
  companyId     String?      @map("company_id") @db.Uuid
  company       CoreCompany? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor         Json
  source        String
  action        String
  entityType    String       @map("entity_type")
  entityId      String       @map("entity_id")
  before        Json?
  after         Json?
  reason        String
  correlationId String       @map("correlation_id") @db.Uuid
  requestId     String?      @map("request_id")
  actionId      String?      @map("action_id")
  prevHash      String       @map("prev_hash") @db.Char(64)
  hash          String       @unique @db.Char(64)

  @@index([entityType, entityId, seq], map: "audit_log_entity_idx")
  @@index([correlationId], map: "audit_log_correlation_idx")
  @@index([companyId, seq], map: "audit_log_company_idx")
  @@map("audit_log")
}

// ── platform/events ─────────────────────────────────────────────────────────

model EventsOutbox {
  eventId         String       @id @map("event_id") @db.Uuid
  seq             BigInt       @unique(map: "events_outbox_seq_key") @default(autoincrement())
  type            String
  schemaVersion   Int          @map("schema_version")
  occurredAt      DateTime     @map("occurred_at") @db.Timestamptz(6)
  effectiveAt     DateTime     @map("effective_at") @db.Date
  correlationId   String       @map("correlation_id") @db.Uuid
  causationId     String?      @map("causation_id") @db.Uuid
  actor           Json
  source          String
  companyId       String?      @map("company_id") @db.Uuid
  company         CoreCompany? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payload         Json
  publishedAt     DateTime?    @map("published_at") @db.Timestamptz(6)
  publishAttempts Int          @default(0) @map("publish_attempts")
  lastError       String?      @map("last_error")

  @@index([correlationId], map: "events_outbox_correlation_idx")
  @@map("events_outbox")
}

model EventsInbox {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("events_inbox")
}

// ── platform/config ─────────────────────────────────────────────────────────

model ConfigSetting {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String
  companyId String?      @map("company_id") @db.Uuid
  company   CoreCompany? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  value     Json
  updatedAt DateTime     @map("updated_at") @db.Timestamptz(6)

  @@unique([key, companyId], map: "config_setting_key_company_uq")
  @@map("config_setting")
}
