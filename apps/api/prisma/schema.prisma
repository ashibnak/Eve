// Eve schema. Models arrive with their slices; tables are prefixed by module slug (ADR-002).
// Constraints Prisma cannot express (exclusion constraints, grants) live in hand-written
// SQL migrations under prisma/migrations/NNNN_<name>/ — forward-only.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── platform/company ────────────────────────────────────────────────────────

model CoreCompany {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique
  jurisdictionCode String   @map("jurisdiction_code")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  auditEntries    AuditLog[]
  outboxEvents    EventsOutbox[]
  settings        ConfigSetting[]
  roleAssignments AuthRoleAssignment[]
  usageEntries    UsageLedger[]
  ruleParams      RulesParamVersion[]
  approvals       ApprovalsRequest[]
  documents       DocDocument[]
  imports         ConnectorsImport[]
  importMappings  ConnectorsMapping[]
  people          PeoplePerson[]
  peopleStatuses  PeopleEmploymentStatus[]
  userLinks       PeopleUserLink[]
  orgCompany      OrgCompany?

  @@map("core_company")
}

// ── platform/audit (append-only; see migration 0003) ────────────────────────

model AuditLog {
  seq           BigInt       @id @default(autoincrement())
  id            String       @unique @db.Uuid
  recordedAt    DateTime     @map("recorded_at") @db.Timestamptz(6)
  companyId     String?      @map("company_id") @db.Uuid
  company       CoreCompany? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor         Json
  source        String
  action        String
  entityType    String       @map("entity_type")
  entityId      String       @map("entity_id")
  before        Json?
  after         Json?
  reason        String
  correlationId String       @map("correlation_id") @db.Uuid
  requestId     String?      @map("request_id")
  actionId      String?      @map("action_id")
  prevHash      String       @map("prev_hash") @db.Char(64)
  hash          String       @unique @db.Char(64)

  @@index([entityType, entityId, seq], map: "audit_log_entity_idx")
  @@index([correlationId], map: "audit_log_correlation_idx")
  @@index([companyId, seq], map: "audit_log_company_idx")
  @@map("audit_log")
}

// ── platform/events ─────────────────────────────────────────────────────────

model EventsOutbox {
  eventId         String       @id @map("event_id") @db.Uuid
  seq             BigInt       @unique(map: "events_outbox_seq_key") @default(autoincrement())
  type            String
  schemaVersion   Int          @map("schema_version")
  occurredAt      DateTime     @map("occurred_at") @db.Timestamptz(6)
  effectiveAt     DateTime     @map("effective_at") @db.Date
  correlationId   String       @map("correlation_id") @db.Uuid
  causationId     String?      @map("causation_id") @db.Uuid
  actor           Json
  source          String
  companyId       String?      @map("company_id") @db.Uuid
  company         CoreCompany? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payload         Json
  publishedAt     DateTime?    @map("published_at") @db.Timestamptz(6)
  publishAttempts Int          @default(0) @map("publish_attempts")
  lastError       String?      @map("last_error")

  @@index([correlationId], map: "events_outbox_correlation_idx")
  @@map("events_outbox")
}

model EventsInbox {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("events_inbox")
}

// ── platform/config ─────────────────────────────────────────────────────────

model ConfigSetting {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String
  companyId String?      @map("company_id") @db.Uuid
  company   CoreCompany? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  value     Json
  updatedAt DateTime     @map("updated_at") @db.Timestamptz(6)

  @@unique([key, companyId], map: "config_setting_key_company_uq")
  @@map("config_setting")
}

// ── platform/auth ───────────────────────────────────────────────────────────

model AuthUser {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username               String    @unique
  passwordHash           String    @map("password_hash")
  status                 String
  contactChannel         String    @map("contact_channel")
  contactAddress         String    @map("contact_address")
  failedPasswordAttempts Int       @default(0) @map("failed_password_attempts")
  lockedUntil            DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt              DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @map("updated_at") @db.Timestamptz(6)

  sessions        AuthSession[]
  roleAssignments AuthRoleAssignment[]
  activeDays      UsageActiveUser[]
  usageEntries    UsageLedger[]
  approvalsAsked  ApprovalsRequest[]
  approvalActions ApprovalsAction[]
  imports         ConnectorsImport[]
  importMappings  ConnectorsMapping[]
  peopleUserLinks PeopleUserLink[]

  @@map("auth_user")
}

model AuthSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userId     String    @map("user_id") @db.Uuid
  user       AuthUser  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stage      String
  createdAt  DateTime  @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  otps AuthOtp[]

  @@index([userId], map: "auth_session_user_idx")
  @@map("auth_session")
}

model AuthOtp {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String      @map("session_id") @db.Uuid
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  codeHash   String      @map("code_hash") @db.Char(64)
  createdAt  DateTime    @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(6)
  attempts   Int         @default(0)
  consumedAt DateTime?   @map("consumed_at") @db.Timestamptz(6)

  @@index([sessionId, createdAt], map: "auth_otp_session_idx")
  @@map("auth_otp")
}

model AuthRoleAssignment {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  user      AuthUser     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role      String
  scopeKind String       @map("scope_kind")
  companyId String?      @map("company_id") @db.Uuid
  company   CoreCompany? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitId    String?      @map("unit_id") @db.Uuid
  createdAt DateTime     @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime?    @map("revoked_at") @db.Timestamptz(6)

  @@map("auth_role_assignment")
}

// ── platform/usage ──────────────────────────────────────────────────────────

model UsageDaily {
  day    DateTime @db.Date
  module String
  metric String
  count  BigInt   @default(0)

  @@id([day, module, metric])
  @@map("usage_daily")
}

model UsageActiveUser {
  day    DateTime @db.Date
  userId String   @map("user_id") @db.Uuid
  user   AuthUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([day, userId])
  @@map("usage_active_user")
}

model UsageLedger {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt DateTime     @map("occurred_at") @db.Timestamptz(6)
  day        DateTime     @db.Date
  kind       String
  module     String
  skill      String?
  model      String?
  tokensIn   Int?         @map("tokens_in")
  tokensOut  Int?         @map("tokens_out")
  durationMs Int?         @map("duration_ms")
  userId     String?      @map("user_id") @db.Uuid
  user       AuthUser?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyId  String?      @map("company_id") @db.Uuid
  company    CoreCompany? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([day, module], map: "usage_ledger_day_idx")
  @@map("usage_ledger")
}

// ── platform/rules (bitemporal; see migration 0010) ─────────────────────────

model RulesParamVersion {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId        String            @map("template_id")
  templateVersion   Int               @map("template_version")
  companyId         String?           @map("company_id") @db.Uuid
  company           CoreCompany?      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  params            Json
  validFrom         DateTime          @map("valid_from") @db.Date
  validTo           DateTime?         @map("valid_to") @db.Date
  recordedAt        DateTime          @map("recorded_at") @db.Timestamptz(6)
  supersededAt      DateTime?         @map("superseded_at") @db.Timestamptz(6)
  approvalRequestId String?           @map("approval_request_id") @db.Uuid
  approvalRequest   ApprovalsRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "rules_param_version_approval_fk")

  @@index([templateId, templateVersion, companyId, validFrom], map: "rules_param_version_lookup_idx")
  @@map("rules_param_version")
}

// ── platform/approvals ──────────────────────────────────────────────────────

model ApprovalsRequest {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String
  companyId     String?      @map("company_id") @db.Uuid
  company       CoreCompany? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payload       Json
  revision      Int          @default(1)
  status        String
  currentStep   Int          @default(0) @map("current_step")
  chain         Json
  pinnedRules   Json         @default("{}") @map("pinned_rules")
  requestedBy   String       @map("requested_by") @db.Uuid
  requester     AuthUser     @relation(fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  correlationId String       @map("correlation_id") @db.Uuid
  createdAt     DateTime     @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @map("updated_at") @db.Timestamptz(6)
  decidedAt     DateTime?    @map("decided_at") @db.Timestamptz(6)

  actions           ApprovalsAction[]
  ruleParams        RulesParamVersion[]
  imports           ConnectorsImport[]
  orgChangeRequests OrgChangeRequest[]
  orgAppliedActions OrgAppliedAction[]

  @@index([requestedBy, status], map: "approvals_request_requester_idx")
  @@map("approvals_request")
}

model ApprovalsAction {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String           @map("request_id") @db.Uuid
  request   ApprovalsRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revision  Int
  step      Int
  action    String
  actorId   String?          @map("actor_id") @db.Uuid
  actor     AuthUser?        @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  note      String?
  payload   Json?
  at        DateTime         @db.Timestamptz(6)

  @@index([requestId, at], map: "approvals_action_request_idx")
  @@map("approvals_action")
}

// ── platform/connectors ─────────────────────────────────────────────────────

model ConnectorsImport {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target            String
  sourceName        String            @map("source_name")
  companyId         String            @map("company_id") @db.Uuid
  company           CoreCompany       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  effectiveDate     DateTime          @map("effective_date") @db.Date
  status            String
  fileName          String            @map("file_name")
  fileFormat        String            @map("file_format")
  fileSize          Int               @map("file_size")
  fileSha256        String            @map("file_sha256") @db.Char(64)
  fileRef           String?           @map("file_ref") @db.Char(64)
  sheets            Json
  mapping           Json?
  counts            Json              @default("{}")
  findings          Json?
  diff              Json?
  approvalRequestId String?           @map("approval_request_id") @db.Uuid
  approvalRequest   ApprovalsRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy         String            @map("created_by") @db.Uuid
  creator           AuthUser          @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt         DateTime          @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @map("updated_at") @db.Timestamptz(6)
  committedAt       DateTime?         @map("committed_at") @db.Timestamptz(6)
  purgedAt          DateTime?         @map("purged_at") @db.Timestamptz(6)

  rows ConnectorsImportRow[]

  @@index([companyId, createdAt], map: "connectors_import_company_idx")
  @@map("connectors_import")
}

model ConnectorsImportRow {
  importId  String           @map("import_id") @db.Uuid
  import    ConnectorsImport @relation(fields: [importId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sheet     String
  rowNumber Int              @map("row_number")
  entity    String
  key       String?
  values    Json
  errors    Json             @default("[]")

  @@id([importId, sheet, rowNumber])
  @@map("connectors_import_row")
}

model ConnectorsMapping {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target     String
  companyId  String      @map("company_id") @db.Uuid
  company    CoreCompany @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceName String      @map("source_name")
  mapping    Json
  updatedBy  String      @map("updated_by") @db.Uuid
  updater    AuthUser    @relation(fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedAt  DateTime    @map("updated_at") @db.Timestamptz(6)

  @@unique([target, companyId, sourceName], map: "connectors_mapping_source_uq")
  @@map("connectors_mapping")
}

// ── packs/hr/people ─────────────────────────────────────────────────────────

model PeoplePerson {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  company        CoreCompany @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personnelCode  String      @map("personnel_code")
  firstNameFa    String      @map("first_name_fa")
  lastNameFa     String      @map("last_name_fa")
  firstNameEn    String?     @map("first_name_en")
  lastNameEn     String?     @map("last_name_en")
  hireDate       DateTime    @map("hire_date") @db.Date
  contactChannel String?     @map("contact_channel")
  contactAddress String?     @map("contact_address")
  createdAt      DateTime    @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @map("updated_at") @db.Timestamptz(6)

  statuses  PeopleEmploymentStatus[]
  userLinks PeopleUserLink[]

  @@unique([companyId, personnelCode], map: "people_person_code_uq")
  @@map("people_person")
}

model PeopleEmploymentStatus {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId   String       @map("person_id") @db.Uuid
  person     PeoplePerson @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyId  String       @map("company_id") @db.Uuid
  company    CoreCompany  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status     String
  validFrom  DateTime     @map("valid_from") @db.Date
  validTo    DateTime?    @map("valid_to") @db.Date
  recordedAt DateTime     @map("recorded_at") @db.Timestamptz(6)

  @@index([companyId, validFrom], map: "people_employment_status_company_idx")
  @@map("people_employment_status")
}

model PeopleUserLink {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  user      AuthUser     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyId String       @map("company_id") @db.Uuid
  company   CoreCompany  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personId  String       @map("person_id") @db.Uuid
  person    PeoplePerson @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedAt  DateTime     @map("linked_at") @db.Timestamptz(6)
  endedAt   DateTime?    @map("ended_at") @db.Timestamptz(6)

  @@map("people_user_link")
}

// ── packs/hr/org (exclusion constraints and the R15 trigger: migration 0016) ────────

model OrgCompany {
  companyId      String      @id @map("company_id") @db.Uuid
  company        CoreCompany @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nameFa         String      @map("name_fa")
  nameEn         String?     @map("name_en")
  codePrefix     String      @unique @map("code_prefix")
  legalFields    Json        @default("{}") @map("legal_fields")
  nextUnitNo     Int         @default(1) @map("next_unit_no")
  nextPositionNo Int         @default(1) @map("next_position_no")
  createdAt      DateTime    @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @map("updated_at") @db.Timestamptz(6)

  levels           OrgUnitLevel[]
  units            OrgUnit[]
  unitVersions     OrgUnitVersion[]
  positions        OrgPosition[]
  positionVersions OrgPositionVersion[]
  reportingLines   OrgReportingLine[]
  assignments      OrgAssignment[]
  ruleRuns         OrgRuleRun[]
  findings         OrgFinding[]
  pendingEvents    OrgPendingEvent[]
  changeRequests   OrgChangeRequest[]
  appliedActions   OrgAppliedAction[]

  @@map("org_company")
}

model OrgUnitLevel {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String     @map("company_id") @db.Uuid
  company   OrgCompany @relation(fields: [companyId], references: [companyId], onDelete: NoAction, onUpdate: NoAction)
  nameFa    String     @map("name_fa")
  nameEn    String?    @map("name_en")
  rank      Int

  versions OrgUnitVersion[]

  @@unique([companyId, rank], map: "org_unit_level_rank_uq")
  @@map("org_unit_level")
}

model OrgUnit {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String     @map("company_id") @db.Uuid
  company   OrgCompany @relation(fields: [companyId], references: [companyId], onDelete: NoAction, onUpdate: NoAction)
  code      String
  createdAt DateTime   @map("created_at") @db.Timestamptz(6)

  versions         OrgUnitVersion[]     @relation("UnitVersions")
  childVersions    OrgUnitVersion[]     @relation("UnitParent")
  positionVersions OrgPositionVersion[]

  @@unique([companyId, code], map: "org_unit_code_uq")
  @@map("org_unit")
}

model OrgUnitVersion {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId               String        @map("unit_id") @db.Uuid
  unit                 OrgUnit       @relation("UnitVersions", fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyId            String        @map("company_id") @db.Uuid
  company              OrgCompany    @relation(fields: [companyId], references: [companyId], onDelete: NoAction, onUpdate: NoAction)
  legacyCode           String?       @map("legacy_code")
  nameFa               String        @map("name_fa")
  nameEn               String?       @map("name_en")
  levelId              String?       @map("level_id") @db.Uuid
  level                OrgUnitLevel? @relation(fields: [levelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentUnitId         String?       @map("parent_unit_id") @db.Uuid
  parentUnit           OrgUnit?      @relation("UnitParent", fields: [parentUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  costCenter           String?       @map("cost_center")
  location             String?
  supervisorPositionId String?       @map("supervisor_position_id") @db.Uuid
  supervisorPosition   OrgPosition?  @relation(fields: [supervisorPositionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "org_unit_version_supervisor_fk")
  status               String
  validFrom            DateTime      @map("valid_from") @db.Date
  validTo              DateTime?     @map("valid_to") @db.Date
  recordedAt           DateTime      @map("recorded_at") @db.Timestamptz(6)

  @@index([companyId, validFrom], map: "org_unit_version_company_idx")
  @@index([parentUnitId], map: "org_unit_version_parent_idx")
  @@map("org_unit_version")
}

model OrgPosition {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String     @map("company_id") @db.Uuid
  company   OrgCompany @relation(fields: [companyId], references: [companyId], onDelete: NoAction, onUpdate: NoAction)
  code      String
  createdAt DateTime   @map("created_at") @db.Timestamptz(6)

  versions        OrgPositionVersion[]
  supervisedUnits OrgUnitVersion[]
  linesFrom       OrgReportingLine[]   @relation("LineFrom")
  linesTo         OrgReportingLine[]   @relation("LineTo")
  assignments     OrgAssignment[]

  @@unique([companyId, code], map: "org_position_code_uq")
  @@map("org_position")
}

model OrgPositionVersion {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  positionId  String      @map("position_id") @db.Uuid
  position    OrgPosition @relation(fields: [positionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyId   String      @map("company_id") @db.Uuid
  company     OrgCompany  @relation(fields: [companyId], references: [companyId], onDelete: NoAction, onUpdate: NoAction)
  legacyCode  String?     @map("legacy_code")
  titleFa     String      @map("title_fa")
  titleEn     String?     @map("title_en")
  unitId      String      @map("unit_id") @db.Uuid
  unit        OrgUnit     @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobId       String?     @map("job_id")
  type        String
  fte         Decimal     @db.Decimal(4, 3)
  supervisory Boolean
  status      String
  source      String
  validFrom   DateTime    @map("valid_from") @db.Date
  validTo     DateTime?   @map("valid_to") @db.Date
  recordedAt  DateTime    @map("recorded_at") @db.Timestamptz(6)

  @@index([companyId, validFrom], map: "org_position_version_company_idx")
  @@index([unitId], map: "org_position_version_unit_idx")
  @@map("org_position_version")
}

model OrgReportingLine {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  company        OrgCompany  @relation(fields: [companyId], references: [companyId], onDelete: NoAction, onUpdate: NoAction)
  fromPositionId String      @map("from_position_id") @db.Uuid
  fromPosition   OrgPosition @relation("LineFrom", fields: [fromPositionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toPositionId   String      @map("to_position_id") @db.Uuid
  toPosition     OrgPosition @relation("LineTo", fields: [toPositionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind           String
  validFrom      DateTime    @map("valid_from") @db.Date
  validTo        DateTime?   @map("valid_to") @db.Date
  recordedAt     DateTime    @map("recorded_at") @db.Timestamptz(6)

  @@index([toPositionId, kind], map: "org_reporting_line_to_idx")
  @@index([companyId, kind], map: "org_reporting_line_company_idx")
  @@map("org_reporting_line")
}

model OrgAssignment {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  company     OrgCompany  @relation(fields: [companyId], references: [companyId], onDelete: NoAction, onUpdate: NoAction)
  personId    String      @map("person_id") @db.Uuid
  positionId  String      @map("position_id") @db.Uuid
  position    OrgPosition @relation(fields: [positionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind        String
  timeShare   Decimal     @map("time_share") @db.Decimal(4, 3)
  source      String
  actionRef   String?     @map("action_ref")
  orderNumber String?     @map("order_number")
  validFrom   DateTime    @map("valid_from") @db.Date
  validTo     DateTime?   @map("valid_to") @db.Date
  recordedAt  DateTime    @map("recorded_at") @db.Timestamptz(6)

  @@index([positionId, kind], map: "org_assignment_position_idx")
  @@index([personId], map: "org_assignment_person_idx")
  @@index([companyId, validFrom], map: "org_assignment_company_idx")
  @@map("org_assignment")
}

model OrgRuleRun {
