            "to": "p2"
          }
        ]
      },
      "params": {},
      "output": {
        "violations": [
          {
            "subject": {
              "type": "position",
              "id": "p3"
            },
            "key": "manager_outside_unit_line",
            "detail": {
              "managerPositionId": "p2",
              "unitId": "u3",
              "managerUnitId": "u2"
            }
          }
        ]
