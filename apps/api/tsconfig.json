{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "exactOptionalPropertyTypes": false,
    "customConditions": ["eve-source"],
    "types": ["node"]
  },
  "include": [
    "src",
    "test",
    "scripts",
    "acceptance",
    "prisma.config.ts",
    "vitest.config.mts",
    "vitest.int.config.mts",
    "vitest.perf.config.mts",
    "vitest.acceptance.config.mts",
    "vitest.shared.mts"
  ]
}
