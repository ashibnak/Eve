{
  "name": "eve",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "pnpm --filter @eve/api db:generate",
    "dev": "pnpm -r --parallel --filter @eve/api --filter @eve/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . && stylelint \"apps/web/src/**/*.css\"",
    "typecheck": "pnpm -r typecheck && tsc -p tools/tsconfig.json",
    "test": "vitest run",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:i18n": "tsx tools/i18n/check-keys.ts",
    "e2e": "pnpm --filter @eve/web e2e",
    "format": "prettier --write .",
    "test:unit": "vitest run --project '!@eve/api:int'",
    "test:perf": "vitest run --config apps/api/vitest.perf.config.mts",
    "acceptance": "vitest run --config apps/api/vitest.acceptance.config.mts",
    "db:dev:up": "docker compose -f deploy/docker-compose.dev.yml up -d --wait",
    "db:dev:down": "docker compose -f deploy/docker-compose.dev.yml down",
    "db:check-drift": "tsx apps/api/scripts/check-schema-drift.ts",
    "rules:golden": "tsx --conditions=eve-source apps/api/scripts/write-rule-golden.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "stylelint": "17.16.0",
    "stylelint-use-logical": "2.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
