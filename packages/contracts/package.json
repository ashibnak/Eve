{
  "name": "@eve/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Versioned contracts per module (packages/contracts/<slug>/v1). Filled from S1.",
  "type": "module",
  "exports": {
    ".": {
      "eve-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./platform/v1": {
      "eve-source": "./src/platform/v1/index.ts",
      "types": "./dist/platform/v1/index.d.ts",
      "default": "./dist/platform/v1/index.js"
    },
    "./hr/canonical/v1": {
      "eve-source": "./src/hr/canonical/v1/index.ts",
      "types": "./dist/hr/canonical/v1/index.d.ts",
      "default": "./dist/hr/canonical/v1/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
